<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="437.0" prefWidth="410.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.registro_app.controller.EstudianteController">
   <children>
      <Label text="Nombres" />
      <TextField fx:id="txtNombres" promptText="Juan Roman" />
      <Label text="Apellidos" />
      <TextField fx:id="txtApellidos" promptText="Romero Mejia" />
      <Label text="Fecha de nacimiento" />
      <DatePicker fx:id="dpfechaNac" promptText="Ingrese su fecha de nacimiento">
         <VBox.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </VBox.margin></DatePicker>
      <Label fx:id="lblGenero" text="Genero">
         <VBox.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </VBox.margin>
      </Label>
      <ComboBox fx:id="combGenero" prefWidth="150.0">
         <VBox.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </VBox.margin>
      </ComboBox>
      <Label text="Carrera" />
      <TextField fx:id="txtCarrera" promptText="ING. DE SISTEMAS" />
      <CheckBox fx:id="chktieneBeca" mnemonicParsing="false" text="Tiene Beca">
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin></CheckBox>
      <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#guardarOnClick" text="Agregar">
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin></Button>
      <Label fx:id="lblRegistro" text="Registros guardados: 0">
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin></Label>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
